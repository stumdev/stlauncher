{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "STLauncher",
  "version": "1.0.0",
  "identifier": "com.stlauncher.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "STLauncher",
        "width": 860,
        "height": 560,
        "resizable": false,
        "maximizable": false,
        "center": true,
        "decorations": false,
        "shadow": true,
        "theme": "Dark",
        "backgroundColor": "#161b26"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "languages": ["PortugueseBR"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZCQUY5MEIwRTBBQzZERkIKUldUN2JhemdzSkN2YTFCRS9XdDRjbDhHbHRpTC9ZaDFadjYwdW9uQ0FWSXlJVTlVNlFpV1pKUXYK",
      "windows": { "installMode": "passive" }
    }
  }
}
