# Copie para .env e ajuste. Tudo é opcional, exceto ADMIN_TOKEN para publicar.
PORT=8080
HOST=0.0.0.0
# Gere um token forte (mín. 16 caracteres):  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=
# Pasta de dados (pack e instaladores do launcher). Padrão ./data
DATA_DIR=./data
# PACK_DIR=./data/pack
# LAUNCHER_DIR=./data/launcher
# URL pública, usada no link de download do launcher. Vazio = deduz do header Host.
PUBLIC_URL=
# Requisições por minuto por IP nas rotas /api (arquivos do pack não têm limite)
RATE_LIMIT_MAX=120
# true se estiver atrás de proxy reverso (Caddy/nginx) para o IP real ser usado
TRUST_PROXY=false
